# =============================================================================
# NGINX config for api.harmony4all.org
# =============================================================================
#
# IMPORTANT: Do NOT add CORS headers here.
# Express already handles CORS in index.js.
# Adding CORS in both nginx AND Express causes duplicate headers and breaks the
# admin app with: "Access-Control-Allow-Origin header contains multiple values"
#
# HOW TO FIND CONFIG:
#   sudo nano /etc/nginx/sites-available/api.harmony4all.org
#
# AFTER EDITING:
#   sudo nginx -t && sudo systemctl reload nginx
#
# =============================================================================

server {
    server_name api.harmony4all.org;

    # Must be >= backend video limit (100MB). Use 150M for headroom.
    client_max_body_size 150M;
    client_body_timeout 600s;

    location / {
        proxy_pass http://localhost:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_request_buffering off;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/api.harmony4all.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.harmony4all.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
